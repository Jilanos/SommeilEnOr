# Copy to .env. Never commit .env.
# Port published on the host loopback interface (the HTTPS reverse proxy targets it).
SOMMEILENOR_PORT=8000
# Keep true behind HTTPS. Set false only for plain-HTTP local testing.
SOMMEILENOR_SECURE_COOKIES=true
# Session lifetime in days.
SOMMEILENOR_SESSION_DAYS=90
# Account creation: open (default) or closed. Existing accounts can still sign in.
SOMMEILENOR_REGISTRATION=open
